# Fix for vLLM 0.19.0 MiniCPM-o audio inputs longer than one chunk: upstream fails with
# "only integer tensors of a single element can be converted to an index".
# Apply inside site-packages: patch -p1 < vllm-0.19.0-minicpmo-audio.patch
--- a/vllm/model_executor/models/minicpmo.py
+++ b/vllm/model_executor/models/minicpmo.py
