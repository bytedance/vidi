  ],
  "prov:wasGeneratedBy": [
    {
      "@type": "prov:Activity",
      "name": "ASR and face preprocessing",
      "description": "WhisperX-style ASR and face detection/tracking were used to propose speech and face metadata."
    },
    {
      "@type": "prov:Activity",
      "name": "Model-assisted question generation and adversarial refinement",
      "description": "MLLM prompts generated candidate questions and refined distractors before human verification. Later distractor revisions are documented in datasets/README.md."
    },
    {
      "@type": "prov:Activity",
      "name": "Human verification",
      "description": "Independent human checks and senior adjudication were used for the original annotations. Version-specific annotation limitations are documented in datasets/README.md."
    }
  ],
