  "@type": "sc:Dataset",
  "name": "CineMME",
  "description": "CineMME is a movie-scene benchmark for evaluating coupled cinematic grounding and reasoning. It contains a grounding track with timestamped speech transcripts and active-speaker face boxes, and a reasoning track with multiple-choice and open-ended cinematic questions.",
